make_bar <- function(value, max_value, color) {
width_pct <- round(100 * value / max_value, 1)
value_rounded <- round(value, 2)
glue('<span style="display:inline-block; width:100px; background:linear-gradient(to right, {color} {width_pct}%, transparent {width_pct}%); padding:2px 6px; border-radius:2px;">{value_rounded}</span>')
}
